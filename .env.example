# ============================================================
# FITCORE PRO - VARIÁVEIS DE AMBIENTE EXEMPLO
# Nunca colocar senhas reais neste arquivo.
# ============================================================

NODE_ENV=development

FITCORE_SITE_URL=http://localhost:3000
FITCORE_ADMIN_URL=http://localhost:3001
FITCORE_API_URL=http://localhost:3333

# Banco principal do FitCore.
# MVP-07 usa esta URL para aplicar o schema real.
# Se ficar vazio, a API mantém fallback seguro em JSON local.
FITCORE_DATABASE_URL=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fitcore
POSTGRES_USER=fitcore
POSTGRES_PASSWORD=trocar_essa_senha

REDIS_HOST=localhost
REDIS_PORT=6379

WGER_API_URL=http://localhost/api/v2
WGER_API_TOKEN=

OPENAI_API_KEY=

WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

PAYMENT_PROVIDER=asaas
ASAAS_API_KEY=

SENTRY_DSN=

# Open-source capability layer (#14)
# Serviços pesados ficam fora do app/mobile e só podem responder em loopback.
FITCORE_CRAWL4AI_ENABLED=false
FITCORE_CRAWL4AI_URL=http://127.0.0.1:11235
FITCORE_CRAWL4AI_TOKEN=
FITCORE_WEB_KNOWLEDGE_ALLOWLIST=

# Shared semantic sidecar managed canonically by MarcaIA (#40).
# Keep disabled until the loopback ScrapeGraphAI smoke gate is green.
FITCORE_SCRAPEGRAPH_ENABLED=false
FITCORE_SCRAPEGRAPH_URL=http://127.0.0.1:11236
FITCORE_SCRAPEGRAPH_TOKEN=

FITCORE_STIRLING_PDF_ENABLED=false
FITCORE_STIRLING_PDF_URL=http://127.0.0.1:8089
FITCORE_STIRLING_PDF_API_KEY=
